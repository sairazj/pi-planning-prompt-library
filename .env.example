# ─── Atlassian MCP Server Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Jira
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# Confluence (often the same credentials as Jira)
CONFLUENCE_URL=https://your-org.atlassian.net
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# ─── Project Defaults (optional — used by Claude commands) ───────────────────
# Default Jira project key (e.g. MYPROJ)
DEFAULT_JIRA_PROJECT=

# Default Confluence space key for your team
DEFAULT_TEAM_SPACE=

# Default Confluence space key for ART-level pages
DEFAULT_ART_SPACE=

# Current PI label used in Jira (e.g. PI-27)
CURRENT_PI_LABEL=
